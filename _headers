# Cloudflare Pages response headers (also understood by Netlify; ignored by GitHub Pages).
#
# The main Content-Security-Policy lives in index.html as a <meta> tag. The header below ADDS
# the directives a <meta> CSP cannot express (frame-ancestors, form-action); browsers enforce
# both policies together, so this can only tighten things, never loosen them.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()

# Content-hashed build output: a changed file always gets a new name, so cache it for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked, or users get stuck on an old version.
/sw.js
  Cache-Control: no-cache

# Not content-hashed, and they must match the version of the main bundle — revalidate every
# time (a cheap 304 when unchanged) rather than risk a stale worker after an upgrade.
/pdf.worker.min.mjs
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache

/tesseract/*
  Cache-Control: no-cache

# Bundled Unicode fonts never change under the same name.
/fonts/*
  Cache-Control: public, max-age=2592000
